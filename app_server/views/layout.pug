doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title= title + ' | Cakes by Isabelle'
    link(rel="stylesheet", href="/stylesheets/bootstrap.min.css")
    link(rel="stylesheet", href="/stylesheets/font-awesome.min.css")
    link(rel="stylesheet", href="/stylesheets/style.css")
  body.d-flex.flex-column.min-vh-100
    nav.navbar.navbar-expand-md.navbar-dark.navbar-cake.sticky-top
      .container
        a.navbar-brand.d-flex.align-items-center.gap-2.p-0(href="/")
          span.brand Cakes by Isabelle

        button.navbar-toggler(type="button", data-bs-toggle="collapse", data-bs-target="#mainNav")
          span.navbar-toggler-icon

        #mainNav.collapse.navbar-collapse
          ul.navbar-nav.nav-pills.mx-md-auto.gap-md-1.my-3.my-md-0
            - const links = [['/', 'home', 'Menu'], ['/login', 'login', 'Log in'], ['/register', 'register', 'Register'], ['/orders', 'orders', 'My Orders']]
            each l in links
              li.nav-item
                a.nav-link.px-3(href=l[0], class={active: active === l[1]})= l[2]
                .d-flex.align-items-center.gap-2
          if user
            span.small.session-label Hi, #{user.name.split(' ')[0]}
            form(method="post", action="/logout")
              button.btn.btn-outline-light.btn-sm.rounded-pill(type="submit") Sign out
          else
            span.small.session-label Not signed in
          button#signOutBtn.btn.btn-outline-light.btn-sm.rounded-pill.d-none(type="button", onclick="signOut()") Sign out

    include mixins/icons

    block content

    script(src="/javascripts/bootstrap.min.js")