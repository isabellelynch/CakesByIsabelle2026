section.screen.d-none#screen-register
  .container.py-5
    .row.justify-content-center
      .col-12.col-sm-10.col-md-7.col-lg-5.col-xl-4
        .card.auth-card.shadow-sm
          .card-body.p-4.p-sm-5.pt-sm-5
            .text-center.mb-2
              svg(width="56", height="56", viewBox="0 0 60 60", fill="none", xmlns="http://www.w3.org/2000/svg", aria-hidden="true")
                circle(cx="30", cy="21", r="10", fill="var(--pink-blush)")
                path(d="M30 15a6 6 0 0 1 6 6", stroke="var(--pink-deep)", stroke-width="2.5", fill="none", stroke-linecap="round")
                path(d="M12 50c2-11 9.5-17 18-17s16 6 18 17", stroke="var(--brown-mid)", stroke-width="4", fill="none", stroke-linecap="round")
            h2.h3.text-center.mt-3 Create your account
            p.text-center.text-body-secondary.mb-4 Save your details for faster checkout.

            form(onsubmit="return handleRegister(event)", novalidate)
              .mb-3
                label.form-label.fw-semibold.small(for="regName") Full name
                input#regName.form-control(type="text", autocomplete="name", placeholder="Jane Doe", required)
                #regNameError.invalid-feedback
              .mb-3
                label.form-label.fw-semibold.small(for="regEmail") Email
                input#regEmail.form-control(type="email", autocomplete="email", placeholder="you@example.com", required)
                #regEmailError.invalid-feedback
              .mb-3
                label.form-label.fw-semibold.small(for="regPassword") Password
                input#regPassword.form-control(type="password", autocomplete="new-password", placeholder="At least 8 characters", required)
                #regPasswordError.invalid-feedback
              button.btn.btn-primary.w-100.mt-2(type="submit") Create account

            p.text-center.small.text-body-secondary.mt-4.mb-0
              | Already have an account? 
              button.btn.btn-link.btn-sm.p-0.align-baseline.fw-semibold(type="button", onclick="go('login')") Log in
