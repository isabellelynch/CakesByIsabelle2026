extends layout

block content
  main.flex-grow-1
    section#screen-orders
      .container.py-5
        if !user
          .text-center.py-5
            h1.h3 My Orders
            p.text-body-secondary Log in to see your orders.
            a.btn.btn-primary.rounded-pill.px-4(href="/login") Log in
        else
          h1.h3 My Orders
          p.text-body-secondary.mb-4 Signed in as #{user.name}
          app-orders-list Loading your orders...

block styles
  link(rel="stylesheet", href="/build/styles.css")

block scripts
  script(type="module", src="/build/main.js")
