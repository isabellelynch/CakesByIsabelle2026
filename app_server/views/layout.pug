doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title= title
    link(rel="stylesheet", href="/stylesheets/bootstrap.min.css")
    link(rel="stylesheet", href="/stylesheets/font-awesome.min.css")
    link(rel="stylesheet", href="/stylesheets/style.css")
  body.d-flex.flex-column.min-vh-100
    nav.navbar.navbar-expand-md.navbar-dark.navbar-cake.sticky-top(aria-label="Primary")
      .container
        button.navbar-brand.border-0.bg-transparent.d-flex.align-items-center.gap-2.p-0(type="button", onclick="go('home')", aria-label=title + ', go to home')
          span.brand #{title}

        button.navbar-toggler(type="button", data-bs-toggle="collapse", data-bs-target="#mainNav", aria-controls="mainNav", aria-expanded="false", aria-label="Toggle navigation")
          span.navbar-toggler-icon

        #mainNav.collapse.navbar-collapse
          ul.navbar-nav.nav-pills.mx-md-auto.gap-md-1.my-3.my-md-0
            li.nav-item
              button.nav-link.px-3(type="button", data-route="home", onclick="go('home')") Menu
            li.nav-item
              button.nav-link.px-3(type="button", data-route="login", onclick="go('login')") Log in
            li.nav-item
              button.nav-link.px-3(type="button", data-route="register", onclick="go('register')") Register
            li.nav-item
              button.nav-link.px-3(type="button", data-route="orders", onclick="go('orders')") My Orders
          .d-flex.align-items-center.gap-2
            span#sessionLabel.small.session-label Not signed in
            button#signOutBtn.btn.btn-outline-light.btn-sm.rounded-pill.d-none(type="button", onclick="signOut()") Sign out
            
    include mixins/icons

    block content

    script(src="/javascripts/bootstrap.min.js")
    script(src="/javascripts/cake-app.js")
