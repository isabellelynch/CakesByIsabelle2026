section.screen.d-none#screen-login
  .container.py-5
    .row.justify-content-center
      .col-12.col-sm-10.col-md-7.col-lg-5.col-xl-4
        .card.auth-card.shadow-sm
          .card-body.p-4.p-sm-5.pt-sm-5
            .text-center.mb-2
              svg(width="56", height="56", viewBox="0 0 60 60", fill="none", xmlns="http://www.w3.org/2000/svg", aria-hidden="true")
                rect(x="10", y="26", width="40", height="26", rx="8", fill="var(--pink-blush)")
                path(d="M18 26v-6a12 12 0 0 1 24 0v6", stroke="var(--brown-mid)", stroke-width="4", fill="none", stroke-linecap="round")
                circle(cx="30", cy="38", r="4.5", fill="var(--pink-deep)")
                rect(x="28.5", y="40", width="3", height="7", rx="1.5", fill="var(--pink-deep)")
            h2.h3.text-center.mt-3 Welcome back
            p.text-center.text-body-secondary.mb-4 Log in to track your orders.

            #loginNote.alert.alert-cake.small.d-none(role="status")

            form(onsubmit="return handleLogin(event)", novalidate)
              .mb-3
                label.form-label.fw-semibold.small(for="loginEmail") Email
                input#loginEmail.form-control(type="email", autocomplete="email", placeholder="you@example.com", required)
                #loginEmailError.invalid-feedback
              .mb-3
                label.form-label.fw-semibold.small(for="loginPassword") Password
                input#loginPassword.form-control(type="password", autocomplete="current-password", placeholder="••••••••", required)
                #loginPasswordError.invalid-feedback
              button.btn.btn-primary.w-100.mt-2(type="submit") Log in

            p.text-center.small.text-body-secondary.mt-4.mb-0
              | New here? 
              button.btn.btn-link.btn-sm.p-0.align-baseline.fw-semibold(type="button", onclick="go('register')") Create an account
