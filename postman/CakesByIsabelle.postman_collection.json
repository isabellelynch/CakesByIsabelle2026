{
  "info": {
    "_postman_id": "c33f1b88-8dad-4680-b3f8-024abd52010c",
    "name": "Cakes by Isabelle API",
    "description": "Tests for the Cakes by Isabelle REST API, including the Passport login.\n\nBefore running: in the collection's Variables tab, set email and password (Current value) to a real account.\nbaseUrl is the Render site. To test locally, change it to https://localhost:3000 and turn off Settings > General > SSL certificate verification (the local certificate is self-signed).\n\nRun the whole collection in order with the Collection Runner. Postman keeps the session cookie between requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login (Passport)",
      "item": [
        {
          "name": "Log out (start clean)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logged out and sent back to the home page', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "description": "Clears any session left over from an earlier run, so the next tests start logged out.",
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logout"
              ]
            }
          }
        },
        {
          "name": "Orders without login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Returns the error message', () => {",
                  "  pm.expect(pm.response.json().message).to.eql('You must be logged in to do that');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "The orders API is protected by Passport: without a session it returns 401.",
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            }
          }
        },
        {
          "name": "Add cake without login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Returns the error message', () => {",
                  "  pm.expect(pm.response.json().message).to.eql('You must be logged in to do that');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "description": "Changing the menu also needs a logged-in user.",
            "url": {
              "raw": "{{baseUrl}}/api/cakes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cakes"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "id",
                  "value": "c99",
                  "type": "text"
                },
                {
                  "key": "name",
                  "value": "Test cake",
                  "type": "text"
                },
                {
                  "key": "price",
                  "value": "10",
                  "type": "text"
                }
              ]
            }
          }
        },
        {
          "name": "Wrong password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login page is shown again with an error', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.text()).to.include('Incorrect email or password');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "description": "Passport's LocalStrategy rejects a wrong password.",
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "email",
                  "value": "{{email}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "wrong-password",
                  "type": "text"
                }
              ]
            }
          }
        },
        {
          "name": "Log in",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logged in and redirected to My Orders', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.text()).to.include('Signed in as');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "description": "Logs in with Passport. Postman keeps the session cookie, so every request after this one is logged in.",
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "email",
                  "value": "{{email}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Cakes",
      "item": [
        {
          "name": "List cakes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns a non-empty array of cakes', () => {",
                  "  const cakes = pm.response.json();",
                  "  pm.expect(cakes).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(cakes[0]).to.have.all.keys('_id', 'name', 'desc', 'price', '__v');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "Lists every cake on the menu.",
            "url": {
              "raw": "{{baseUrl}}/api/cakes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cakes"
              ]
            }
          }
        },
        {
          "name": "One cake",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns Rosewater Vanilla', () => {",
                  "  const cake = pm.response.json();",
                  "  pm.expect(cake._id).to.eql('c1');",
                  "  pm.expect(cake.name).to.eql('Rosewater Vanilla');",
                  "  pm.expect(cake.price).to.eql(32);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "",
            "url": {
              "raw": "{{baseUrl}}/api/cakes/c1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cakes",
                "c1"
              ]
            }
          }
        },
        {
          "name": "Missing cake",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Returns the error message', () => {",
                  "  pm.expect(pm.response.json().message).to.eql('Cake not found');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "Error case: a cake id that does not exist.",
            "url": {
              "raw": "{{baseUrl}}/api/cakes/xyz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cakes",
                "xyz"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Place order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const order = pm.response.json();",
                  "pm.test('Order is saved with the cake price copied in', () => {",
                  "  pm.expect(order).to.have.property('_id');",
                  "  pm.expect(order.email).to.eql(pm.collectionVariables.get('email'));",
                  "  pm.expect(order.cake).to.eql('c1');",
                  "  pm.expect(order.price).to.eql(32);",
                  "  pm.expect(order.status).to.eql('pending');",
                  "});",
                  "// remember the new order's id for the next requests",
                  "pm.collectionVariables.set('orderId', order._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "description": "Creates a new order for the logged-in user (the email comes from the session). Its id is saved in the orderId variable for the requests below.",
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "cake",
                  "value": "c1",
                  "type": "text"
                },
                {
                  "key": "deliveryDate",
                  "value": "2026-12-04",
                  "type": "text"
                }
              ]
            }
          }
        },
        {
          "name": "Read new order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Cake is populated', () => {",
                  "  const order = pm.response.json();",
                  "  pm.expect(order._id).to.eql(pm.collectionVariables.get('orderId'));",
                  "  pm.expect(order.cake.name).to.eql('Rosewater Vanilla');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "",
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderId}}"
              ]
            }
          }
        },
        {
          "name": "Update order status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status changed to ready', () => {",
                  "  pm.expect(pm.response.json().status).to.eql('ready');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [],
            "description": "",
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderId}}"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "status",
                  "value": "ready",
                  "type": "text"
                }
              ]
            }
          }
        },
        {
          "name": "Bad order (no deliveryDate)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Explains what failed', () => {",
                  "  pm.expect(pm.response.json().message).to.include('deliveryDate');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "description": "Error case: validation should reject an order without a delivery date.",
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "cake",
                  "value": "c1",
                  "type": "text"
                }
              ]
            }
          }
        },
        {
          "name": "My orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Only this customer\\'s orders, newest first', () => {",
                  "  const orders = pm.response.json();",
                  "  pm.expect(orders).to.be.an('array').that.is.not.empty;",
                  "  orders.forEach(o => pm.expect(o.email).to.eql(pm.collectionVariables.get('email')));",
                  "  for (let i = 1; i < orders.length; i++) {",
                  "    pm.expect(new Date(orders[i - 1].orderDate) >= new Date(orders[i].orderDate)).to.be.true;",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "",
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            }
          }
        },
        {
          "name": "Delete new order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "description": "Clean-up: removes the test order so repeated runs don't fill the database.",
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderId}}"
              ]
            }
          }
        },
        {
          "name": "Deleted order is gone",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Returns the error message', () => {",
                  "  pm.expect(pm.response.json().message).to.eql('Order not found');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "",
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderId}}"
              ]
            }
          }
        },
        {
          "name": "Log out",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logged out', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "description": "",
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logout"
              ]
            }
          }
        },
        {
          "name": "Orders after logging out",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Returns the error message', () => {",
                  "  pm.expect(pm.response.json().message).to.eql('You must be logged in to do that');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "After logging out the session is gone, so the API refuses again.",
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            }
          }
        }
      ]
    }
