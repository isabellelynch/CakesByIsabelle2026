extends layout

block content
  main.flex-grow-1
    section#screen-home
      .container.py-5
        .row.align-items-center.g-5
          .col-md-7
            p.fw-semibold.text-accent.mb-2 Small-batch bakery, made to order
            h1.display-5.fw-medium.mb-3 Cakes worth clearing your afternoon for.
            p.lead.text-body-secondary.
              Every order is baked fresh the morning it ships — no freezers, no shortcuts.
              Pick a favourite below, or tell us the occasion and we'll build something around it.
            .d-flex.flex-wrap.gap-2.mt-4
              a.btn.btn-primary.btn-lg.rounded-pill.px-4(href="/register") Create an account
              a.btn.btn-outline-secondary.btn-lg.rounded-pill.px-4(href="/login") Sign in
          .col-md-5.order-first.order-md-last.text-center
            +cakeIcon(400)

      section.container.pb-5
        .d-flex.flex-wrap.justify-content-between.align-items-baseline.gap-2.mb-4
          h2.h3.mb-0 This week's menu
          p.text-body-secondary.mb-0 Order by Thursday for weekend collection.
        #cakeGrid.row.g-4